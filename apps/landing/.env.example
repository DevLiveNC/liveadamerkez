# Tarayıcıdan API'ye doğrudan adres. Boş bırakılırsa aynı origin kullanılır;
# Next.js /v1/* isteklerini sunucu tarafında API_URL'e yönlendirir (PWA/preview önerilen).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=
AUTH_SECRET=
OTP_PEPPER=
# Sunucu tarafındaki API adresi; BFF ve /v1 rewrite bunu kullanır.
API_URL=http://localhost:3001
# API ile aynı olmalı. Test erişimi yalnız yerel/önizleme için açılır; canlıda off.
AUTH_TEST_LOGIN=off
AUTH_TEST_PHONES=+905391180204
